# Separate gateway with TLS and client_auth: require. Kept apart from
# gateway.yaml.tmpl because mandatory mTLS would break every plain-HTTP test.
schema: v1
debug: false

gateway:
  service:
    name: aastro-integration-tls
  server:
    port: {{.Port}}
    tls:
      enabled: true
      cert_file: {{.TLSDir}}/server.crt
      key_file: {{.TLSDir}}/server.key
      min_version: "1.2"
      client_auth: require
      client_ca_file: {{.TLSDir}}/ca.crt
  admin:
    port: {{.AdminPort}}
    bind_addr: 127.0.0.1
  routing:
    flows:
      - path: /single/{id}
        method: GET
        upstreams:
          - name: profile
            hosts: {{.Profile}}
            path: /users/{id}
            forward_params: [ "id" ]
            forward_queries: [ "*" ]
      - path: /users/{id}/events
        method: GET
        streaming: true
        upstreams:
          - name: stream
            hosts: {{.Stream}}
            path: /users/{id}/events
            forward_params: [ "id" ]
            forward_queries: [ "*" ]
